# The dashboard is built/tested with npm ci && npm run build before packaging.
FROM public.ecr.aws/lambda/python:3.12@sha256:0fe974382dcb297e80e7feb8c7620d7e8ece5b42b4d01a5a9ffe939c654bf8b0
COPY requirements-next.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-next.lock
COPY src/fareflare ./fareflare
COPY web/dist ./web
CMD ["fareflare.product_runtime.handler"]
