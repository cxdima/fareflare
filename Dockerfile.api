# The dashboard is built/tested with npm ci && npm run build before packaging.
FROM public.ecr.aws/lambda/python:3.15@sha256:f20d4d9f01b6243129ea7fa196f74cfa0ab6144cdd4c78bdff368802eefe7c6e
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY src/fareflare ./fareflare
COPY web/dist ./web
CMD ["fareflare.product_runtime.handler"]
