{
  "name": "fareflare-web",
  "version": "2.1.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host 127.0.0.1 --port 5173 --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/font-license.mjs",
    "test": "playwright test",
    "test:types": "tsc --project tsconfig.tests.json",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src scripts/*.mjs tests/*.ts *.ts *.json README.md",
    "format:check": "prettier --check src scripts/*.mjs tests/*.ts *.ts *.json README.md"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fontsource-variable/mona-sans": "5.3.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
