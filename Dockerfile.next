# Build the stable Dockerfile as gfpt-browser-base first; this image is separate.
ARG BROWSER_BASE=gfpt-browser-base
FROM ${BROWSER_BASE}
COPY requirements-next.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements-next.lock
COPY src/gfpt_next ./gfpt_next
CMD ["gfpt_next.runtime.handler"]
